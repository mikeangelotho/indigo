{
  "$schema": "https://opencode.ai/config.json",
  "toolFormat": "indigo",
  "formatOptions": {
    "indigo": {
      "description": "Indigo format: {\"function_name\": \"tool_name\", \"arguments\": {...}}",
      "tools": ["list_files", "read_file", "write_file", "run_shell"]
    },
    "opencode": {
      "description": "OpenCode AI format: {\"name\": \"tool_name\", \"arguments\": {...}}",
      "tools": ["list_files", "read_file", "write_file", "run_shell", "web_search"]
    },
    "continue": {
      "description": "Continue.dev format: {\"name\": \"tool_name\", \"arguments\": {...}}",
      "tools": ["list_files", "read_file", "write_file", "run_shell"]
    },
    "cursor": {
      "description": "Cursor format: {\"name\": \"tool_name\", \"arguments\": {...}}",
      "tools": ["list_files", "read_file", "write_file", "run_shell"]
    },
    "claude": {
      "description": "Claude Code format: {\"name\": \"tool_name\", \"arguments\": {...}}",
      "tools": ["list_files", "read_file", "write_file", "run_shell"]
    }
  }
}